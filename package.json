{
  "name": "dsh-feishu-bridge",
  "version": "0.1.3",
  "description": "Feishu/Lark WebSocket bridge for DeepSeek Harness: chat with your agent from anywhere.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "feishu",
    "lark",
    "bridge"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.build.json && tsc -p tsconfig.test.json && node --test --test-isolation=none lib-test/test/*.test.js"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}
